{
  "expo": {
    "name": "AppRendimiento",
    "slug": "apprendimiento",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apprendimiento",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.pbdevhouse.avanza",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.pbdevhouse.avanza",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#243B8F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "La cámara se usa para sacar fotos de tus comidas, escanear códigos de barras y la foto de fondo de lo que compartís.",
          "photosPermission": "La galería se usa para elegir fotos de tus comidas y la foto de fondo de lo que compartís.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Se usa para guardar en tu galería la imagen de tu entrenamiento."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La ubicación se usa para medir los km mientras corrés, caminás o andás en bici con el cronómetro."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para sacar fotos de tus comidas, escanear códigos de barras y la foto de fondo de lo que compartís.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e253399-7044-40a7-9c36-10902e6ea375"
      }
    },
    "owner": "tiagop10"
  }
}
